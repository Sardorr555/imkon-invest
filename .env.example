RAGFLOW_BASE_URL=https://your-ragflow.example.com
RAGFLOW_API_KEY=
RAGFLOW_CHAT_ID=
RAGFLOW_INVESTOR_CHAT_ID=
RAGFLOW_BUSINESS_CHAT_ID=
# Swipies native Chat API: avoids the affected OpenAI-compatible handler.
RAGFLOW_API_MODE=native
# Comma-separated trusted ChatGPT account emails. Never use editable profile emails.
ADMIN_EMAILS=
# Optional for older versions:
# RAGFLOW_COMPLETIONS_PATH=/api/v1/chats_openai/{chat_id}/chat/completions
